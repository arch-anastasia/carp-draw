{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vue-tsc --noEmit && vite build",
        "lint": "eslint . --fix",
        "format": "prettier --write \"resources/js/**/*.{vue,js,ts,tsx,css}\"",
        "type-check": "vue-tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@inertiajs/vue3": "^2.0.0",
        "lucide-vue-next": "^0.545.0",
        "vue": "^3.5.0",
        "ziggy-js": "^2.6.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.0.0",
        "@tailwindcss/vite": "^4.1.0",
        "@types/node": "^22.0.0",
        "@vitejs/plugin-vue": "^6.0.0",
        "@vitest/coverage-v8": "^3.0.0",
        "@vue/test-utils": "^2.4.0",
        "@vue/tsconfig": "^0.7.0",
        "eslint": "^9.0.0",
        "eslint-config-prettier": "^10.0.0",
        "eslint-plugin-vue": "^10.0.0",
        "globals": "^16.0.0",
        "happy-dom": "^17.0.0",
        "laravel-vite-plugin": "^2.0.0",
        "prettier": "^3.4.0",
        "tailwindcss": "^4.1.0",
        "typescript": "~5.7.0",
        "typescript-eslint": "^8.0.0",
        "vite": "^7.0.0",
        "vitest": "^3.0.0",
        "vue-tsc": "^2.2.0"
    },
    "allowScripts": {
        "esbuild@0.28.2": true
    }
}
