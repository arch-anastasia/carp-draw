APP_NAME="CarpDraw AI"
APP_TAGLINE="From a reference to a clear technical drawing."
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Load-bearing: every generated URL, canonical and sitemap entry is built
# from this host (PinUrlRoot middleware), not the request host.
APP_URL=http://localhost:8000
APP_VERSION=1.0.0

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Zero-dependency local default. Production runs PostgreSQL — see
# docker-compose.yml.
DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_QUEUE_RETRY_AFTER=360

# Docker: MAIL_MAILER=smtp MAIL_HOST=mailpit MAIL_PORT=1025 (UI on :8025).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@carpdraw.ai"
MAIL_FROM_NAME="${APP_NAME}"

# Support/contact identity shown on the marketing pages and used for
# operational alerts (contact form, new subscribers).
SUPPORT_EMAIL=arch.anastasia.ivanova@gmail.com
SUPPORT_PHONE="+421 918 135 587"
ADMIN_NOTIFICATIONS_EMAIL=

# ---------------------------------------------------------------------------
# Stripe / billing (Cashier). Prices are read live from Stripe and cached;
# without keys the app falls back to the configured EUR prices and the
# checkout button reports a friendly error.
# ---------------------------------------------------------------------------
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
CASHIER_CURRENCY=eur
STRIPE_MAKER_PRICE_ID=
STRIPE_MAKER_PRICE_ID_YEARLY=
STRIPE_STUDIO_PRICE_ID=
STRIPE_STUDIO_PRICE_ID_YEARLY=
STRIPE_TRIAL_DAYS=0
STRIPE_PRICE_CACHE_TTL_MINUTES=60

# ---------------------------------------------------------------------------
# Drawing pipeline. `fake` runs the whole flow with bundled sample sheets —
# no key, no cost. Switch to gemini|openai with a real key for live output.
# ---------------------------------------------------------------------------
DRAWING_PROVIDER=fake
DRAWING_DISK=local
DRAWING_FREE_CREDITS=12
DRAWING_SUBSCRIBED_CREDITS=40
DRAWING_CREDITS_DRAWING=4
DRAWING_CREDITS_MODEL=4
DRAWING_CREDITS_SPECIFICATION=4
# Invariant when QUEUE_CONNECTION=redis: provider timeout < job timeout <
# worker --timeout < REDIS_QUEUE_RETRY_AFTER.
DRAWING_JOB_TIMEOUT=75
DRAWING_MAX_INPUT_EDGE=1024

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_TIMEOUT=60

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1536x1024
OPENAI_IMAGE_QUALITY=high
# Keep under DRAWING_JOB_TIMEOUT.
OPENAI_TIMEOUT=60

# ---------------------------------------------------------------------------
# OAuth sign-in. A provider's button appears once its client id is set.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_REDIRECT_URI="${APP_URL}/auth/apple/callback"

# ---------------------------------------------------------------------------
# Observability (all optional; everything degrades to no-ops when empty).
# ---------------------------------------------------------------------------
SENTRY_LARAVEL_DSN=
SENTRY_BROWSER_DSN=
SENTRY_ENVIRONMENT="${APP_ENV}"
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_SEND_DEFAULT_PII=false

POSTHOG_ENABLED=false
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

VITE_APP_NAME="${APP_NAME}"

# Editorial publishing API (closed until a token is configured)
BLOG_API_TOKEN=
BLOG_API_THROTTLE=60
INDEXNOW_KEY=
RUNTIME_IMAGES_DISK=public
